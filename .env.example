# =============================================================================
# Azure AD app registration
# =============================================================================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =============================================================================
# OAuth tokens — populated by `npm run auth:setup` after first run
# =============================================================================
GRAPH_REFRESH_TOKEN=
GRAPH_ACCESS_TOKEN=
TOKEN_EXPIRES_AT=

# =============================================================================
# Anthropic
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# Webhook config
# =============================================================================
WEBHOOK_BASE_URL=https://your-function-app.azurewebsites.net
WEBHOOK_CLIENT_STATE_SECRET=generate_a_random_string_here

# =============================================================================
# OneDrive paths (relative to the user's OneDrive root, must start with /)
# =============================================================================
# Email pipeline
ONEDRIVE_BILLS_PATH=/Documents/BillHunter/bills.xlsx
ONEDRIVE_TAX_PATH_PREFIX=/Documents/BillHunter/taxes_
ONEDRIVE_ATTACHMENTS_DIR=/Documents/BillHunter/attachments

# Statement parser
ONEDRIVE_STATEMENTS_INBOX=/Documents/BillHunter/statements/inbox
ONEDRIVE_STATEMENTS_PROCESSED=/Documents/BillHunter/statements/processed
ONEDRIVE_TRANSACTIONS_PATH_PREFIX=/Documents/BillHunter/transactions_

# Rentals
ONEDRIVE_RENTALS_INBOX=/Documents/BillHunter/rentals/inbox
ONEDRIVE_RENTALS_PROCESSED=/Documents/BillHunter/rentals/processed
ONEDRIVE_RENTALS_PATH_PREFIX=/Documents/BillHunter/rentals_

# P&L + CPA packet
ONEDRIVE_PL_DIR=/Documents/BillHunter/pl
ONEDRIVE_CPA_PACKETS_DIR=/Documents/BillHunter

# =============================================================================
# Discord summary (optional)
# =============================================================================
DISCORD_WEBHOOK_URL=

# =============================================================================
# Entity hints
# =============================================================================
ENTITIES=NHP-1941,NHDPM,Sol Haus,Personal
